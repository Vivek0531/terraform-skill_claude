pipeline {
  agent { label 'terraform' }

  parameters {
    choice(name: 'CLOUD',       choices: ['aws', 'azure'],                         description: 'Target cloud provider')
    choice(name: 'ENVIRONMENT', choices: ['dev', 'staging', 'production'],         description: 'Target environment')
    choice(name: 'COMPONENT',   choices: ['all', 'eks', 'kafka', 'monitoring', 'logging'], description: 'Component to deploy')
    booleanParam(name: 'DESTROY', defaultValue: false,                             description: 'Destroy infrastructure')
    booleanParam(name: 'AUTO_APPROVE', defaultValue: false,                        description: 'Skip plan approval (non-prod only)')
  }

  environment {
    TF_VAR_environment    = "${params.ENVIRONMENT}"
    AWS_DEFAULT_REGION    = 'us-east-1'
    TERRAGRUNT_VERSION    = '0.67.0'
    TERRAFORM_VERSION     = '1.9.0'
    WORKING_DIR           = "terragrunt/live/${params.CLOUD}"
  }

  options {
    timeout(time: 90, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '20'))
    disableConcurrentBuilds(abortPrevious: true)
  }

  stages {
    stage('Validate') {
      steps {
        script {
          if (params.DESTROY && params.ENVIRONMENT == 'production') {
            error('DESTROY is not allowed on production via pipeline. Use break-glass procedure.')
          }
          if (params.AUTO_APPROVE && params.ENVIRONMENT == 'production') {
            error('AUTO_APPROVE is not allowed on production.')
          }
        }
      }
    }

    stage('Checkout') {
      steps {
        checkout scm
        sh 'git log -1 --pretty=format:"%h %s" | tee .git-commit-info'
      }
    }

    stage('Setup Tools') {
      steps {
        sh '''
          # Install Terraform
          if ! terraform version 2>/dev/null | grep -q "${TERRAFORM_VERSION}"; then
            curl -sLo /tmp/terraform.zip https://releases.hashicorp.com/terraform/${TERRAFORM_VERSION}/terraform_${TERRAFORM_VERSION}_linux_amd64.zip
            unzip -o /tmp/terraform.zip -d /usr/local/bin/
          fi

          # Install Terragrunt
          if ! terragrunt --version 2>/dev/null | grep -q "${TERRAGRUNT_VERSION}"; then
            curl -sLo /usr/local/bin/terragrunt https://github.com/gruntwork-io/terragrunt/releases/download/v${TERRAGRUNT_VERSION}/terragrunt_linux_amd64
            chmod +x /usr/local/bin/terragrunt
          fi

          terraform version
          terragrunt --version
          aws --version
          helm version
          kubectl version --client
        '''
      }
    }

    stage('Authenticate') {
      steps {
        withCredentials([
          string(credentialsId: "aws-role-arn-${params.ENVIRONMENT}", variable: 'AWS_ROLE_ARN')
        ]) {
          sh '''
            aws sts assume-role \
              --role-arn "${AWS_ROLE_ARN}" \
              --role-session-name "jenkins-${JOB_NAME}-${BUILD_NUMBER}" \
              --duration-seconds 3600 \
              --query 'Credentials.[AccessKeyId,SecretAccessKey,SessionToken]' \
              --output text | read -r AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN
            export AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN
            aws sts get-caller-identity
          '''
        }
      }
    }

    stage('Init') {
      steps {
        dir(env.WORKING_DIR) {
          sh '''
            if [ "${COMPONENT}" = "all" ]; then
              terragrunt run-all init --terragrunt-non-interactive
            else
              cd ${COMPONENT} && terragrunt init --terragrunt-non-interactive
            fi
          '''
        }
      }
    }

    stage('Validate Config') {
      steps {
        dir(env.WORKING_DIR) {
          sh '''
            if [ "${COMPONENT}" = "all" ]; then
              terragrunt run-all validate
            else
              cd ${COMPONENT} && terragrunt validate
            fi
          '''
        }
      }
    }

    stage('Plan') {
      steps {
        dir(env.WORKING_DIR) {
          sh '''
            PLAN_FLAGS=""
            if [ "${DESTROY}" = "true" ]; then
              PLAN_FLAGS="-destroy"
            fi

            if [ "${COMPONENT}" = "all" ]; then
              terragrunt run-all plan ${PLAN_FLAGS} \
                --terragrunt-non-interactive \
                -out=tfplan \
                2>&1 | tee plan.log
            else
              cd ${COMPONENT}
              terragrunt plan ${PLAN_FLAGS} -out=tfplan 2>&1 | tee plan.log
            fi
          '''
        }
      }
      post {
        always {
          archiveArtifacts artifacts: "${env.WORKING_DIR}/**/plan.log", allowEmptyArchive: true
        }
      }
    }

    stage('Approval') {
      when {
        anyOf {
          expression { params.ENVIRONMENT == 'production' }
          expression { params.ENVIRONMENT == 'staging' && !params.AUTO_APPROVE }
        }
      }
      steps {
        timeout(time: 30, unit: 'MINUTES') {
          input message: "Approve ${params.DESTROY ? 'DESTROY' : 'apply'} to ${params.ENVIRONMENT}?",
                ok: 'Approve',
                submitter: 'platform-leads,sre-leads'
        }
      }
    }

    stage('Apply') {
      steps {
        dir(env.WORKING_DIR) {
          sh '''
            APPLY_CMD="apply tfplan"
            if [ "${DESTROY}" = "true" ]; then
              APPLY_CMD="destroy -auto-approve"
            fi

            if [ "${COMPONENT}" = "all" ]; then
              terragrunt run-all ${APPLY_CMD} --terragrunt-non-interactive
            else
              cd ${COMPONENT}
              terragrunt ${APPLY_CMD}
            fi
          '''
        }
      }
    }

    stage('Verify Infrastructure') {
      when { expression { !params.DESTROY } }
      steps {
        sh '''
          # Update kubeconfig
          aws eks update-kubeconfig \
            --name "payments-api-eks" \
            --region "${AWS_DEFAULT_REGION}"

          # Wait for all nodes ready
          kubectl wait --for=condition=Ready nodes --all --timeout=300s

          # Verify Prometheus up
          kubectl wait --for=condition=Ready pods \
            -l app.kubernetes.io/name=prometheus \
            -n monitoring \
            --timeout=120s

          # Verify Grafana up
          kubectl wait --for=condition=Ready pods \
            -l app.kubernetes.io/name=grafana \
            -n monitoring \
            --timeout=120s

          echo "Infrastructure verification passed"
        '''
      }
    }

    stage('Verify Kafka Installation') {
      when {
        allOf {
          expression { !params.DESTROY }
          anyOf {
            expression { params.COMPONENT == 'all' }
            expression { params.COMPONENT == 'kafka' }
          }
        }
      }
      steps {
        sh '''
          BOOTSTRAP="kafka.kafka.svc.cluster.local:9092"
          BROKER_POD=$(kubectl get pod -n kafka -l app.kubernetes.io/component=broker \
            -o jsonpath='{.items[0].metadata.name}' 2>/dev/null || \
            kubectl get pod -n kafka -l app.kubernetes.io/name=kafka \
            -o jsonpath='{.items[0].metadata.name}')

          echo "==> [1/6] Waiting for all Kafka broker pods to be Ready..."
          kubectl wait --for=condition=Ready pods \
            -l app.kubernetes.io/name=kafka \
            -n kafka \
            --timeout=300s
          READY_COUNT=$(kubectl get pods -n kafka -l app.kubernetes.io/name=kafka \
            --field-selector=status.phase=Running --no-headers | wc -l)
          echo "    Kafka pods ready: ${READY_COUNT}"
          [ "${READY_COUNT}" -ge 3 ] || { echo "ERROR: fewer than 3 Kafka pods running"; exit 1; }

          echo ""
          echo "==> [2/6] Verifying KRaft controller quorum..."
          kubectl exec -n kafka "${BROKER_POD}" -- \
            kafka-metadata-quorum.sh \
              --bootstrap-server "${BOOTSTRAP}" \
              describe --status | grep -E "LeaderId|CurrentOffset"

          echo ""
          echo "==> [3/6] Verifying all payment topics exist..."
          TOPICS=$(kubectl exec -n kafka "${BROKER_POD}" -- \
            kafka-topics.sh --bootstrap-server "${BOOTSTRAP}" --list)
          echo "${TOPICS}"

          REQUIRED_TOPICS="payments.initiated payments.processing payments.completed payments.failed payments.dlq audit.events"
          for topic in ${REQUIRED_TOPICS}; do
            echo "${TOPICS}" | grep -q "^${topic}$" || \
              { echo "ERROR: topic '${topic}' not found"; exit 1; }
            echo "    [OK] ${topic}"
          done

          echo ""
          echo "==> [4/6] Verifying topic partitions and ISR (min.insync.replicas=2)..."
          for topic in ${REQUIRED_TOPICS}; do
            kubectl exec -n kafka "${BROKER_POD}" -- \
              kafka-topics.sh --bootstrap-server "${BOOTSTRAP}" \
                --describe --topic "${topic}" | \
              grep -E "PartitionCount|ReplicationFactor|Isr"
          done

          echo ""
          echo "==> [5/6] Produce + consume smoke test on payments.initiated..."
          TEST_MSG="ci-smoke-test-$(date +%s)"
          kubectl exec -n kafka "${BROKER_POD}" -- \
            bash -c "echo '${TEST_MSG}' | \
              kafka-console-producer.sh \
                --bootstrap-server ${BOOTSTRAP} \
                --topic payments.initiated"

          CONSUMED=$(kubectl exec -n kafka "${BROKER_POD}" -- \
            kafka-console-consumer.sh \
              --bootstrap-server "${BOOTSTRAP}" \
              --topic payments.initiated \
              --from-beginning \
              --max-messages 1 \
              --timeout-ms 15000 2>/dev/null)
          echo "    Consumed: ${CONSUMED}"
          echo "${CONSUMED}" | grep -q "${TEST_MSG}" || \
            { echo "ERROR: smoke test message not received"; exit 1; }
          echo "    [OK] Produce/consume round-trip verified"

          echo ""
          echo "==> [6/6] Verifying Kafka metrics endpoint (JMX exporter)..."
          kubectl exec -n kafka "${BROKER_POD}" -- \
            curl -sf "http://localhost:5556/metrics" | grep -c "kafka_" | \
            xargs -I{} sh -c '[ {} -gt 0 ] && echo "    [OK] {} Kafka metric series exposed" || \
              { echo "ERROR: JMX metrics not available"; exit 1; }'

          echo ""
          echo "==> Kafka installation verification complete"
        '''
      }
    }
  }

  post {
    success {
      slackSend(
        channel: '#payments-deployments',
        color: 'good',
        message: """
          *${params.DESTROY ? 'DESTROY' : 'Deploy'} SUCCESS*
          Environment: ${params.ENVIRONMENT} | Cloud: ${params.CLOUD} | Component: ${params.COMPONENT}
          Build: <${BUILD_URL}|#${BUILD_NUMBER}>
        """
      )
    }
    failure {
      slackSend(
        channel: '#payments-deployments',
        color: 'danger',
        message: """
          *${params.DESTROY ? 'DESTROY' : 'Deploy'} FAILED*
          Environment: ${params.ENVIRONMENT} | Cloud: ${params.CLOUD} | Component: ${params.COMPONENT}
          Build: <${BUILD_URL}|#${BUILD_NUMBER}>
        """
      )
    }
    always {
      cleanWs()
    }
  }
}

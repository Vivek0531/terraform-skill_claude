pipeline {
  agent { label 'terraform' }

  parameters {
    choice(name: 'CLOUD',       choices: ['aws', 'azure'],                                    description: 'Target cloud provider')
    choice(name: 'ENVIRONMENT', choices: ['dev', 'staging', 'production'],                    description: 'Target environment')
    choice(name: 'COMPONENT',   choices: ['all', 'eks', 'kafka', 'keda', 'monitoring', 'logging'], description: 'Component to deploy')
    booleanParam(name: 'DESTROY',      defaultValue: false, description: 'Destroy infrastructure')
    booleanParam(name: 'AUTO_APPROVE', defaultValue: false, description: 'Skip plan approval (non-prod only)')
  }

  environment {
    TF_VAR_environment    = "${params.ENVIRONMENT}"
    AWS_DEFAULT_REGION    = 'us-east-1'
    TERRAGRUNT_VERSION    = '0.67.0'
    TERRAFORM_VERSION     = '1.9.0'
    WORKING_DIR           = "examples/eks-confluent-kafka/terragrunt/live/${params.CLOUD}"
    KAFKA_BOOTSTRAP       = 'kafka.kafka.svc.cluster.local:9092'
    VA_CLAIMS_TOPICS      = 'claims.submitted claims.eligibility.check claims.processing claims.approved claims.denied claims.appeal claims.payment notifications.veteran claims.dlq audit.trail'
  }

  options {
    timeout(time: 90, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '20'))
    disableConcurrentBuilds(abortPrevious: true)
  }

  stages {

    stage('Validate') {
      steps {
        script {
          if (params.DESTROY && params.ENVIRONMENT == 'production') {
            error('DESTROY is not allowed on production via pipeline. Use break-glass procedure.')
          }
          if (params.AUTO_APPROVE && params.ENVIRONMENT == 'production') {
            error('AUTO_APPROVE is not allowed on production.')
          }
        }
      }
    }

    stage('Checkout') {
      steps {
        checkout scm
        sh 'git log -1 --pretty=format:"%h %s" | tee .git-commit-info'
      }
    }

    stage('Setup Tools') {
      steps {
        sh '''
          if ! terraform version 2>/dev/null | grep -q "${TERRAFORM_VERSION}"; then
            curl -sLo /tmp/terraform.zip \
              https://releases.hashicorp.com/terraform/${TERRAFORM_VERSION}/terraform_${TERRAFORM_VERSION}_linux_amd64.zip
            unzip -o /tmp/terraform.zip -d /usr/local/bin/
          fi
          if ! terragrunt --version 2>/dev/null | grep -q "${TERRAGRUNT_VERSION}"; then
            curl -sLo /usr/local/bin/terragrunt \
              https://github.com/gruntwork-io/terragrunt/releases/download/v${TERRAGRUNT_VERSION}/terragrunt_linux_amd64
            chmod +x /usr/local/bin/terragrunt
          fi
          terraform version && terragrunt --version && aws --version && helm version && kubectl version --client
        '''
      }
    }

    stage('Authenticate') {
      steps {
        withCredentials([
          string(credentialsId: "aws-role-arn-${params.ENVIRONMENT}", variable: 'AWS_ROLE_ARN')
        ]) {
          sh '''
            aws sts assume-role \
              --role-arn "${AWS_ROLE_ARN}" \
              --role-session-name "jenkins-${JOB_NAME}-${BUILD_NUMBER}" \
              --duration-seconds 3600 \
              --query 'Credentials.[AccessKeyId,SecretAccessKey,SessionToken]' \
              --output text | read -r AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN
            export AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN
            aws sts get-caller-identity
          '''
        }
      }
    }

    stage('Init') {
      steps {
        dir(env.WORKING_DIR) {
          sh '''
            if [ "${COMPONENT}" = "all" ]; then
              terragrunt run-all init --terragrunt-non-interactive
            else
              cd ${COMPONENT} && terragrunt init --terragrunt-non-interactive
            fi
          '''
        }
      }
    }

    stage('Validate Config') {
      steps {
        dir(env.WORKING_DIR) {
          sh '''
            if [ "${COMPONENT}" = "all" ]; then
              terragrunt run-all validate
            else
              cd ${COMPONENT} && terragrunt validate
            fi
          '''
        }
      }
    }

    stage('Plan') {
      steps {
        dir(env.WORKING_DIR) {
          sh '''
            PLAN_FLAGS=""
            [ "${DESTROY}" = "true" ] && PLAN_FLAGS="-destroy"
            if [ "${COMPONENT}" = "all" ]; then
              terragrunt run-all plan ${PLAN_FLAGS} --terragrunt-non-interactive -out=tfplan 2>&1 | tee plan.log
            else
              cd ${COMPONENT} && terragrunt plan ${PLAN_FLAGS} -out=tfplan 2>&1 | tee plan.log
            fi
          '''
        }
      }
      post {
        always {
          archiveArtifacts artifacts: "${env.WORKING_DIR}/**/plan.log", allowEmptyArchive: true
        }
      }
    }

    stage('Approval') {
      when {
        anyOf {
          expression { params.ENVIRONMENT == 'production' }
          expression { params.ENVIRONMENT == 'staging' && !params.AUTO_APPROVE }
        }
      }
      steps {
        timeout(time: 30, unit: 'MINUTES') {
          input message: "Approve ${params.DESTROY ? 'DESTROY' : 'apply'} to ${params.ENVIRONMENT}?",
                ok: 'Approve',
                submitter: 'platform-leads,sre-leads,va-claims-owners'
        }
      }
    }

    stage('Apply') {
      steps {
        dir(env.WORKING_DIR) {
          sh '''
            APPLY_CMD="apply tfplan"
            [ "${DESTROY}" = "true" ] && APPLY_CMD="destroy -auto-approve"
            if [ "${COMPONENT}" = "all" ]; then
              terragrunt run-all ${APPLY_CMD} --terragrunt-non-interactive
            else
              cd ${COMPONENT} && terragrunt ${APPLY_CMD}
            fi
          '''
        }
      }
    }

    stage('Verify Infrastructure') {
      when { expression { !params.DESTROY } }
      steps {
        sh '''
          aws eks update-kubeconfig --name "va-claims-eks" --region "${AWS_DEFAULT_REGION}"
          kubectl wait --for=condition=Ready nodes --all --timeout=300s
          kubectl wait --for=condition=Ready pods -l app.kubernetes.io/name=prometheus -n monitoring --timeout=120s
          kubectl wait --for=condition=Ready pods -l app.kubernetes.io/name=grafana -n monitoring --timeout=120s
          echo "Infrastructure verification passed"
        '''
      }
    }

    stage('Verify Kafka -- VA Claims Topics') {
      when {
        allOf {
          expression { !params.DESTROY }
          anyOf {
            expression { params.COMPONENT == 'all' }
            expression { params.COMPONENT == 'kafka' }
          }
        }
      }
      steps {
        sh '''
          BOOTSTRAP="${KAFKA_BOOTSTRAP}"
          BROKER_POD=$(kubectl get pod -n kafka -l app.kubernetes.io/component=broker \
            -o jsonpath='{.items[0].metadata.name}' 2>/dev/null || \
            kubectl get pod -n kafka -l app.kubernetes.io/name=kafka \
            -o jsonpath='{.items[0].metadata.name}')

          echo "==> [1/6] Broker pods ready..."
          kubectl wait --for=condition=Ready pods -l app.kubernetes.io/name=kafka -n kafka --timeout=300s
          READY=$(kubectl get pods -n kafka -l app.kubernetes.io/name=kafka \
            --field-selector=status.phase=Running --no-headers | wc -l)
          [ "${READY}" -ge 3 ] || { echo "ERROR: fewer than 3 brokers"; exit 1; }
          echo "    [OK] ${READY} brokers running"

          echo "==> [2/6] KRaft quorum..."
          kubectl exec -n kafka "${BROKER_POD}" -- kafka-metadata-quorum.sh \
            --bootstrap-server "${BOOTSTRAP}" describe --status | grep -E "LeaderId|CurrentOffset"

          echo "==> [3/6] VA claims topics present..."
          TOPICS=$(kubectl exec -n kafka "${BROKER_POD}" -- \
            kafka-topics.sh --bootstrap-server "${BOOTSTRAP}" --list)
          for topic in ${VA_CLAIMS_TOPICS}; do
            echo "${TOPICS}" | grep -q "^${topic}$" || { echo "ERROR: topic '${topic}' missing"; exit 1; }
            echo "    [OK] ${topic}"
          done

          echo "==> [4/6] Partitions + ISR per topic..."
          for topic in ${VA_CLAIMS_TOPICS}; do
            kubectl exec -n kafka "${BROKER_POD}" -- kafka-topics.sh \
              --bootstrap-server "${BOOTSTRAP}" --describe --topic "${topic}" | \
              grep -E "PartitionCount|ReplicationFactor|Isr"
          done

          echo "==> [5/6] Produce + consume on claims.submitted..."
          TEST_MSG="va-claim-ci-$(date +%s)"
          kubectl exec -n kafka "${BROKER_POD}" -- \
            bash -c "echo '${TEST_MSG}' | kafka-console-producer.sh \
              --bootstrap-server ${BOOTSTRAP} --topic claims.submitted"
          CONSUMED=$(kubectl exec -n kafka "${BROKER_POD}" -- kafka-console-consumer.sh \
            --bootstrap-server "${BOOTSTRAP}" --topic claims.submitted \
            --from-beginning --max-messages 1 --timeout-ms 15000 2>/dev/null)
          echo "${CONSUMED}" | grep -q "${TEST_MSG}" || { echo "ERROR: smoke test failed"; exit 1; }
          echo "    [OK] claims.submitted round-trip verified"

          echo "==> [6/6] HIPAA audit.trail retention check (>=7yr = 220752000000ms)..."
          RETENTION=$(kubectl exec -n kafka "${BROKER_POD}" -- kafka-topics.sh \
            --bootstrap-server "${BOOTSTRAP}" --describe --topic audit.trail | \
            grep -o 'retention.ms=[0-9]*' | cut -d= -f2)
          [ "${RETENTION}" -ge 220752000000 ] || \
            { echo "ERROR: audit.trail retention ${RETENTION}ms < 7yr (HIPAA)"; exit 1; }
          echo "    [OK] audit.trail retention ${RETENTION}ms (HIPAA compliant)"

          echo "==> VA Claims Kafka verification complete"
        '''
      }
    }

    stage('Verify KEDA -- Consumer Autoscaling') {
      when {
        allOf {
          expression { !params.DESTROY }
          anyOf {
            expression { params.COMPONENT == 'all' }
            expression { params.COMPONENT == 'keda' }
          }
        }
      }
      steps {
        sh '''
          echo "==> [1/3] KEDA operator pods ready..."
          kubectl wait --for=condition=Ready pods -l app=keda-operator -n keda --timeout=120s
          kubectl wait --for=condition=Ready pods -l app=keda-operator-metrics-apiserver -n keda --timeout=120s
          echo "    [OK] KEDA operator running"

          echo "==> [2/3] ScaledObjects for VA claims consumers..."
          SCALED_OBJECTS=$(kubectl get scaledobjects -n va-claims --no-headers \
            -o custom-columns=NAME:.metadata.name 2>/dev/null || echo "")
          REQUIRED="claims-processor-scaler eligibility-checker-scaler payment-processor-scaler appeal-tracker-scaler"
          for scaler in ${REQUIRED}; do
            echo "${SCALED_OBJECTS}" | grep -q "${scaler}" || \
              { echo "ERROR: ScaledObject '${scaler}' not found"; exit 1; }
            echo "    [OK] ${scaler}"
          done

          echo "==> [3/3] ScaledObject Ready + Active status..."
          kubectl get scaledobjects -n va-claims \
            -o custom-columns="NAME:.metadata.name,READY:.status.conditions[?(@.type=='Ready')].status,ACTIVE:.status.conditions[?(@.type=='Active')].status"

          echo "==> KEDA consumer autoscaling verification complete"
        '''
      }
    }

  }

  post {
    success {
      slackSend(
        channel: '#va-claims-deployments',
        color: 'good',
        message: """
          *${params.DESTROY ? 'DESTROY' : 'Deploy'} SUCCESS* -- VA Claims Platform
          Environment: ${params.ENVIRONMENT} | Cloud: ${params.CLOUD} | Component: ${params.COMPONENT}
          Build: <${BUILD_URL}|#${BUILD_NUMBER}>
        """
      )
    }
    failure {
      slackSend(
        channel: '#va-claims-deployments',
        color: 'danger',
        message: """
          *${params.DESTROY ? 'DESTROY' : 'Deploy'} FAILED* -- VA Claims Platform
          Environment: ${params.ENVIRONMENT} | Cloud: ${params.CLOUD} | Component: ${params.COMPONENT}
          Build: <${BUILD_URL}|#${BUILD_NUMBER}>
        """
      )
    }
    always {
      cleanWs()
    }
  }
}
